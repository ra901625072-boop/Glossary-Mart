# ============================================================
# Jay Goga Mart — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env (it's in .gitignore).
# ============================================================

# ---- Core ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET

# ---- Database ----
# SQLite for local dev:
DATABASE_URI=sqlite:///store.db
# PostgreSQL for production (Render sets DATABASE_URL automatically):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Session Security & CORS ----
# Set to true only in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT_MINUTES=30
FRONTEND_URL=https://glossary-mart.vercel.app
CORS_ALLOWED_ORIGINS=https://glossary-mart.vercel.app,http://localhost:3000,http://localhost:5173

# ---- Upload Settings ----
UPLOAD_FOLDER=backend/static/uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# ---- Admin Credentials (seed on first run — change immediately after!) ----
# Must NOT be weak values in production (admin/admin123 will be rejected)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Email (optional — leave blank to skip email verification) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ---- Stripe Payments (optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AWS S3 (optional — leave blank to use local storage) ----
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Rate Limiting (optional — in-memory if blank) ----
# REDIS_URL=redis://default:password@host:6379
REDIS_URL=

# ---- Production Guards ----
SKIP_DB_CREATE=false
MIN_PASSWORD_LENGTH=8
