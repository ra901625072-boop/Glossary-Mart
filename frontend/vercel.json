{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://glossary-mart.onrender.com/api/:path*"
    },
    {
      "source": "/static/uploads/:path*",
      "destination": "https://glossary-mart.onrender.com/static/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:page",
      "destination": "/admin/:page.html"
    },
    {
      "source": "/customer",
      "destination": "/customer/shop.html"
    },
    {
      "source": "/customer/",
      "destination": "/customer/shop.html"
    },
    {
      "source": "/customer.html",
      "destination": "/customer/shop.html"
    },
    {
      "source": "/shop",
      "destination": "/customer/shop.html"
    },
    {
      "source": "/cart",
      "destination": "/customer/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/customer/checkout.html"
    },
    {
      "source": "/orders",
      "destination": "/customer/orders.html"
    },
    {
      "source": "/wishlist",
      "destination": "/customer/wishlist.html"
    },
    {
      "source": "/profile",
      "destination": "/customer/profile.html"
    },
    {
      "source": "/about",
      "destination": "/customer/about.html"
    },
    {
      "source": "/contact",
      "destination": "/customer/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/customer/faq.html"
    },
    {
      "source": "/terms",
      "destination": "/customer/terms.html"
    },
    {
      "source": "/product",
      "destination": "/customer/product.html"
    },
    {
      "source": "/payment",
      "destination": "/customer/payment.html"
    },
    {
      "source": "/invoice",
      "destination": "/customer/invoice.html"
    },
    {
      "source": "/order-confirmation",
      "destination": "/customer/order-confirmation.html"
    },
    {
      "source": "/customer/:page",
      "destination": "/customer/:page.html"
    },
    {
      "source": "/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/register",
      "destination": "/auth/register.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/auth/forgot-password.html"
    },
    {
      "source": "/auth/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/auth/register",
      "destination": "/auth/register.html"
    },
    {
      "source": "/auth/forgot-password",
      "destination": "/auth/forgot-password.html"
    },
    {
      "source": "/auth/:page",
      "destination": "/auth/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
