# Virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Database files (local SQLite storage in database/ directory)
database/*.db
database/*.sqlite
database/*.sqlite3
!database/.gitkeep
logs/
*.log

frontend/static/uploads/*
!frontend/static/uploads/.gitkeep

# Environment variables — never commit real secrets
.env
# Commit .env.example instead (no real values)

# Test & coverage output
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.coveragerc

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

